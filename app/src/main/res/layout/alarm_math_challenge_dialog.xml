<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/dialogPreferredPadding"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/math_challenge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="28sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="@string/math_challenge_title_dismiss" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="?attr/colorOutline" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/math_challenge_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:gravity="center"
            android:textSize="16sp"
            android:maxLines="1"
            tools:text="Problem 1 of 3" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/math_challenge_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="28sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="(23 + 41) \u00D7 7 = ?" />

        <!-- The answer is entered with the keypad below rather than the system keyboard, so the
             challenge also works before the first unlock, when the user's keyboard app may not
             be able to run (it is not necessarily Direct Boot aware). -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/answer_display"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/math_challenge_answer_background"
            android:gravity="center"
            android:hint="@string/math_challenge_answer_hint"
            android:maxLines="1"
            android:textColor="?attr/colorPrimary"
            android:textColorHint="?attr/colorOutline"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="448" />

        <GridLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:useDefaultMargins="false" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/math_challenge_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:drawableStart="@drawable/ic_error"
            android:drawablePadding="10dp"
            android:text="@string/math_challenge_wrong_answer"
            android:textStyle="bold"
            android:textColor="?attr/colorError"
            android:maxLines="1"
            android:textSize="24sp"
            app:drawableTint="?attr/colorError"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="24sp"
            app:autoSizeStepGranularity="1sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
