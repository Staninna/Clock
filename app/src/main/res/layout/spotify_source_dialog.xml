<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/dialogPreferredPadding"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_content_paste"
            app:endIconContentDescription="@string/spotify_paste"
            app:helperTextEnabled="true"
            app:helperText="@string/spotify_link_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/spotify_link_hint"
                android:inputType="textUri"
                android:imeOptions="actionNext"
                tools:ignore="TextContrastCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/spotify_name_hint"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                tools:ignore="TextContrastCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/spotify_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingHorizontal="2dp"
            android:text="@string/spotify_fallback_info"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            app:dividerColor="?attr/colorOutline" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/open_spotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="2dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_open_in_new"
            android:drawablePadding="20dp"
            android:text="@string/spotify_open_app"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
