<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only

    Android 12 and later. Everything is backed up except the debug log, which has no size limit.
    Alarms, settings, custom sounds, fonts and backgrounds live in device-protected storage.
    Keep the excludes in sync with backup_rules.xml.
-->

<data-extraction-rules>
    <cloud-backup>
        <exclude domain="device_file" path="log_utils_logs.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="device_file" path="log_utils_logs.txt" />
    </device-transfer>
</data-extraction-rules>
