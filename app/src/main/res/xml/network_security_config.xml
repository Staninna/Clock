<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only

    The only network traffic of the app is the optional Home Assistant integration, which talks to
    the user's own server. Home Assistant is usually reached on the local network over plain HTTP
    (e.g. http://homeassistant.local:8123), so cleartext traffic must be allowed. The settings
    screen tells the user when the address is not secure.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Self-signed certificates installed by the user, common for home servers -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
